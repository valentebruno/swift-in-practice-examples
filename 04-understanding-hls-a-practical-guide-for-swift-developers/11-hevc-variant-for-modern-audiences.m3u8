#!/bin/bash

input="input.mp4"

# 1080p HEVC
ffmpeg -i "$input" \
  -c:v libx265 -preset fast -tag:v hvc1 \
  -b:v 2000k -maxrate 2200k -bufsize 4400k \
  -s 1920x1080 \
  -g 120 -keyint_min 120 -sc_threshold 0 \
  -c:a aac -b:a 128k \
  -f hls \
  -hls_segment_type fmp4 \
  -hls_time 6 \
  -hls_list_size 0 \
  -hls_fmp4_init_filename "1080p_init.mp4" \
  -hls_segment_filename "1080p_%03d.m4s" \
  1080p.m3u8

# 720p HEVC
ffmpeg -i "$input" \
  -c:v libx265 -preset fast -tag:v hvc1 \
  -b:v 1000k -maxrate 1100k -bufsize 2200k \
  -s 1280x720 \
  -g 120 -keyint_min 120 -sc_threshold 0 \
  -c:a aac -b:a 96k \
  -f hls \
  -hls_segment_type fmp4 \
  -hls_time 6 \
  -hls_list_size 0 \
  -hls_fmp4_init_filename "720p_init.mp4" \
  -hls_segment_filename "720p_%03d.m4s" \
  720p.m3u8

# 480p HEVC
ffmpeg -i "$input" \
  -c:v libx265 -preset fast -tag:v hvc1 \
  -b:v 500k -maxrate 550k -bufsize 1100k \
  -s 854x480 \
  -g 120 -keyint_min 120 -sc_threshold 0 \
  -c:a aac -b:a 64k \
  -f hls \
  -hls_segment_type fmp4 \
  -hls_time 6 \
  -hls_list_size 0 \
  -hls_fmp4_init_filename "480p_init.mp4" \
  -hls_segment_filename "480p_%03d.m4s" \
  480p.m3u8

# Create master playlist
cat > master.m3u8 << EOF
#EXTM3U
#EXT-X-VERSION:7
#EXT-X-STREAM-INF:BANDWIDTH=2200000,RESOLUTION=1920x1080,CODECS="hvc1.1.6.L120.90,mp4a.40.2"
1080p.m3u8
#EXT-X-STREAM-INF:BANDWIDTH=1100000,RESOLUTION=1280x720,CODECS="hvc1.1.6.L120.90,mp4a.40.2"
720p.m3u8
#EXT-X-STREAM-INF:BANDWIDTH=550000,RESOLUTION=854x480,CODECS="hvc1.1.6.L120.90,mp4a.40.2"
480p.m3u8
EOF

echo "HEVC fMP4 encoding complete!"
